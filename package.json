{
  "name": "@wesend/node",
  "version": "0.1.0",
  "description": "Official Node.js SDK for the WeSend API: SMS, email and one-time code verification for Mongolia.",
  "keywords": [
    "wesend",
    "sms",
    "email",
    "otp",
    "verification",
    "mongolia"
  ],
  "homepage": "https://wesend.mn/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShopMN/wesend-npm.git"
  },
  "license": "MIT",
  "author": "WeSend",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
